<Window x:Class="AutomationStudioWpf.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:logging="clr-namespace:AutomationStudioWpf.Logging"
        Title="日志"
        Width="900"
        Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Margin="10"
            Background="{DynamicResource EditorPanelCardBrush}"
            BorderBrush="{DynamicResource EditorPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Height="42"
                    Background="{DynamicResource EditorPanelElevatedBrush}">
            <Button Content="复制全部" Click="CopyAll_Click" Margin="0,0,8,0" Padding="12,4" />
            <Button Content="清空" Click="Clear_Click" Padding="12,4" />
            <Border Margin="8,0,0,0" Background="{DynamicResource EditorFieldCardBrush}" BorderBrush="{DynamicResource EditorPanelBorderBrush}" BorderThickness="1" CornerRadius="9" Height="24" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAllRadio" Content="全部" IsChecked="True"
                                 Checked="FilterRadio_Checked"
                                 Margin="4,0" Padding="6,0" FontSize="11"
                                 Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                    <RadioButton x:Name="FilterInfoRadio" Content="信息"
                                 Checked="FilterRadio_Checked"
                                 Margin="4,0" Padding="6,0" FontSize="11"
                                 Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                    <RadioButton x:Name="FilterWarnRadio" Content="警告"
                                 Checked="FilterRadio_Checked"
                                 Margin="4,0" Padding="6,0" FontSize="11"
                                 Foreground="{DynamicResource CompileDirtyBorderBrush}" />
                    <RadioButton x:Name="FilterErrorRadio" Content="错误"
                                 Checked="FilterRadio_Checked"
                                 Margin="4,0" Padding="6,0" FontSize="11"
                                 Foreground="{DynamicResource LogErrorBrush}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="LogDirText"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource StatusMutedBrush}"
                       FontSize="11" />
        </StackPanel>
        <RichTextBox x:Name="LogRichTextBox"
                     Background="{DynamicResource EditorChromeBrush}"
                     Foreground="{DynamicResource EditorTextBrush}"
                     BorderThickness="0"
                     Margin="0"
                     FontFamily="Consolas"
                     FontSize="12"
                     IsReadOnly="True"
                     Padding="12,10"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
    </Border>
</Window>
