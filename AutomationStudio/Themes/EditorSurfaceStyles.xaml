<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="EditorSharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="EditorReadonlyChipStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource EditorTextBrightBrush}" />
        <Setter Property="Background" Value="{DynamicResource EditorDisabledChipBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,4,0,12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EditorInspectorTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,5,0,12" />
        <Setter Property="Background" Value="{DynamicResource EditorFieldCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorPanelBorderBrush}" />
        <Setter Property="Padding" Value="9,6" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource EditorSelectedAccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource EditorPanelCardHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource EditorDisabledChipBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource EditorDisabledChipBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EditorInspectorComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,5,0,12" />
        <Setter Property="Background" Value="{DynamicResource EditorFieldCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorPanelBorderBrush}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource EditorSelectedAccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource EditorPanelCardHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource EditorDisabledChipBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource EditorDisabledChipBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EditorInspectorCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}" />
        <Setter Property="Margin" Value="0,2,0,10" />
    </Style>

    <Style x:Key="EditorPanelDropShadowStyle" TargetType="{x:Type Border}">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="8"
                                  BlurRadius="24"
                                  Opacity="0.36"
                                  Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditorSidebarIconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource EditorTextBrightBrush}" />
        <Setter Property="Background" Value="{DynamicResource EditorFieldCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorPanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource EditorPanelCardHoverBrush}" />
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource EditorSelectedBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource EditorListSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource EditorSelectedAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditorFunctionPublishCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Content" Value="公开" />
        <Setter Property="ToolTip" Value="公开后可被其它脚本作为函数库函数调用" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
