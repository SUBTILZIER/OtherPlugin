<Window x:Class="AutomationStudioWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:graph="clr-namespace:AutomationStudioWpf.Graph"
        xmlns:logging="clr-namespace:AutomationStudioWpf.Logging"
        mc:Ignorable="d"
        Title="自动化蓝图编辑器"
        Width="1680"
        Height="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource EditorRootBackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutomationStudioWpf;component/Themes/EditorSharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="{DynamicResource EditorChromeHighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="{DynamicResource EditorListSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="TopToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource EditorTextBrightBrush}" />
            <Setter Property="Background" Value="{DynamicResource EditorToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="0"
                                                  ShadowDepth="0"
                                                  Opacity="0"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource EditorChromeHighlightBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource EditorSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource EditorTextBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource EditorListSelectedBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource EditorSelectedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource EditorSelectedAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Foreground" Value="{DynamicResource EditorMutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContentRenameTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="TextAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Separator}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource EditorPanelBorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContentFolderToggleIconStyle" TargetType="{x:Type Path}">
            <Setter Property="Data" Value="M 0 0 L 6 4 L 0 8 Z" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTreeExpanded}" Value="True">
                    <Setter Property="Data" Value="M 0 0 L 8 0 L 4 6 Z" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ContentAssetContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource DropdownBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DropdownBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="6"
                                                  Opacity="0.34"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ScrollViewer CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContentAssetMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource EditorTextBrightBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource DropdownMutedTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource DropdownHoverBrush}" />
                                <Setter TargetName="MenuItemBorder" Property="BorderBrush" Value="{DynamicResource DropdownBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource DropdownSelectedBrush}" />
                                <Setter TargetName="MenuItemBorder" Property="BorderBrush" Value="{DynamicResource EditorSelectedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContentAssetMenuIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ContentFolderListItemBaseStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="5,3" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource EditorPanelCardHoverBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource EditorPanelBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource EditorListSelectedBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource EditorSelectedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContentAssetTileContainerStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="104" />
            <Setter Property="Margin" Value="7" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="TileChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileChrome" Property="Background" Value="{DynamicResource EditorPanelCardHoverBrush}" />
                                <Setter TargetName="TileChrome" Property="BorderBrush" Value="{DynamicResource EditorPanelBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource EditorTextBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TileChrome" Property="Background" Value="{DynamicResource EditorListSelectedBrush}" />
                                <Setter TargetName="TileChrome" Property="BorderBrush" Value="{DynamicResource EditorSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScriptEnableBadgeStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="BadgeChrome"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{DynamicResource EditorDisabledChipBrush}"
                                BorderBrush="{DynamicResource EditorDisabledChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="BadgeGlyph"
                                       Text="×"
                                       Foreground="{DynamicResource EditorMutedTextBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BadgeChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="BadgeChrome" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter TargetName="BadgeGlyph" Property="Text" Value="✓" />
                                <Setter TargetName="BadgeGlyph" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BadgeChrome" Property="BorderBrush" Value="{DynamicResource EditorToolTipBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BadgeChrome" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowScriptEnableToggle}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BottomPanelTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource EditorTextBrightBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource EditorTextBrightBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                MinWidth="{TemplateBinding MinWidth}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource EditorListSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource EditorListSelectedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Height="36"
                Background="{DynamicResource EditorPanelBackgroundBrush}"
                BorderBrush="{DynamicResource EditorSectionHeaderBrush}"
                BorderThickness="0,0,0,1"
                >
            <Grid Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Width="18"
                           Height="18"
                           Margin="0,0,8,0"
                           Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource EditorTextBrightBrush}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="WindowMinimize_Click"
                            ToolTip="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="─" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="WindowMaximizeRestore_Click"
                            ToolTip="最大化 / 还原"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="WindowMaximizeGlyph" Text="▢" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="WindowClose_Click"
                            ToolTip="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource LogErrorBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource EditorChromeBrush}"
                BorderBrush="{DynamicResource EditorSectionHeaderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="{DynamicResource EditorToolbarGroupBrush}"
                            BorderBrush="{DynamicResource EditorPanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="外部导入" Style="{StaticResource TopToolbarButtonStyle}" Click="OpenGraph_Click" />
                            <Button Content="保存" Style="{StaticResource TopToolbarButtonStyle}" Click="SaveGraph_Click" />
                            <Button Content="另存为" Style="{StaticResource TopToolbarButtonStyle}" Click="SaveGraphAs_Click" />
                            <Button x:Name="MousePickButton" Content="鼠标拾取" Style="{StaticResource TopToolbarButtonStyle}" Click="MousePick_Click" />
                            <Button x:Name="SettingsButton" Content="设置" Style="{StaticResource TopToolbarButtonStyle}" Click="Settings_Click" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="EditorActionToolbarGroup"
                            Margin="8,0,0,0"
                            Background="{DynamicResource EditorToolbarGroupBrush}"
                            BorderBrush="{DynamicResource EditorPanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="3"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="1"
                                    Height="22"
                                    Margin="3,0,8,0"
                                    Background="{DynamicResource EditorToolbarSeparatorBrush}"
                                    VerticalAlignment="Center" />
                            <Button x:Name="CompileGraphButton" Style="{StaticResource TopToolbarButtonStyle}" Click="CompileGraph_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" Margin="0,0,4,0" />
                                    <TextBlock x:Name="CompileButtonText" Text="编译" />
                                    <Border x:Name="CompileDirtyIcon"
                                            Width="14"
                                            Height="14"
                                            Margin="5,0,0,0"
                                            CornerRadius="7"
                                            Background="{DynamicResource CompileDirtyBorderBrush}"
                                            Visibility="Collapsed">
                                        <TextBlock Text="!" Foreground="#111111" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Content="显示最终代码" Style="{StaticResource TopToolbarButtonStyle}" Click="ShowFinalCode_Click" />
                            <Button x:Name="RunGraphButton" Content="执行脚本" Click="RunGraph_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TopToolbarButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExecuting, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Content" Value="&#x23F3; 执行中..." />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="StopExecutionButton" Content="&#x23F9; 停止执行" Click="StopExecution_Click" Visibility="Collapsed">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TopToolbarButtonStyle}">
                                        <Setter Property="Background" Value="{DynamicResource LogErrorBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="EditorWindowBar"
                DockPanel.Dock="Top"
                MinHeight="42"
                Background="{DynamicResource EditorChromeBrush}"
                BorderBrush="{DynamicResource EditorSectionHeaderBrush}"
                BorderThickness="0,0,0,1"
                Padding="5,1"
                Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding MainEditorSessions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,5,2,5"
                                    Padding="10,6"
                                    MinWidth="150"
                                    MinHeight="30"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Cursor="Hand"
                                    PreviewMouseLeftButtonDown="EditorSessionTab_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="EditorSessionTab_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="EditorSessionTab_PreviewMouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource EditorPanelCardBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource EditorPanelBorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource EditorPanelCardHoverBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource EditorSelectedBorderBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource CompileDirtyBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource EditorListSelectedBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource EditorSelectedBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenuStyle}"
                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="关闭窗口" Click="EditorSessionCloseMenuItem_Click" />
                                        <MenuItem Header="独立窗口" Click="EditorSessionDetachMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="关闭所有窗口" Click="EditorSessionCloseAllMenuItem_Click" />
                                        <MenuItem Header="关闭右侧窗口" Click="EditorSessionCloseRightMenuItem_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="×"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                Margin="8,0,0,0"
                                                FontSize="14"
                                                ToolTip="关闭窗口"
                                                Style="{StaticResource TopToolbarButtonStyle}"
                                                Click="EditorSessionCloseButton_Click" />
                                        <Border DockPanel.Dock="Left"
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,7,0"
                                                CornerRadius="4"
                                                Background="{DynamicResource CompileDirtyBorderBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   Foreground="{DynamicResource EditorTextBrightBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Border Height="2"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="1"
                                            Background="{DynamicResource EditorSelectedAccentBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="LogRow" Height="360" MinHeight="180" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="EditorSurfaceHostRoot"
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="Collapsed" />
            <Border x:Name="EmptyEditorPanel"
                    Grid.Row="0"
                    Margin="10"
                    Background="{DynamicResource EditorCanvasGridBackgroundBrush}"
                    BorderBrush="{DynamicResource EditorPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border Width="420"
                        Padding="28"
                        Background="{DynamicResource EditorPanelCardBrush}"
                        BorderBrush="{DynamicResource EditorPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="打开一个资产开始编辑"
                                   Foreground="{DynamicResource EditorTextBrightBrush}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="从底部内容浏览器双击脚本或函数库。也可以使用工具栏外部导入图谱。"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0" />
                        <Border Height="1"
                                Margin="0,20,0,16"
                                Background="{DynamicResource EditorPanelBorderBrush}" />
                        <TextBlock Text="提示：打开多个资产后，可用上方窗口栏切换，也可以拖出为独立窗口。"
                                    Foreground="{DynamicResource EditorMutedTextBrush}"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>

            <GridSplitter Grid.Row="1"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource EditorSectionHeaderBrush}"
                          ResizeDirection="Rows" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="6,6,3,6"
                        Background="{DynamicResource EditorPanelCardBrush}"
                        BorderBrush="{DynamicResource EditorPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <DockPanel>
                        <StackPanel x:Name="ContentBrowserHeaderBar"
                                    DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Background="{DynamicResource EditorPanelElevatedBrush}"
                                    Height="36">
                            <TextBlock Text="内容浏览器" Style="{StaticResource BottomPanelTitleStyle}" />
                        </StackPanel>
                        <Grid x:Name="ContentBrowserBodyGrid" PreviewMouseDown="ContentBrowserArea_PreviewMouseDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ContentTreeColumn" Width="180" MinWidth="120" MaxWidth="420" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="240" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="ContentFolderListBox"
                                     ItemsSource="{Binding ContentFolderItems}"
                                     Background="{DynamicResource EditorChromeBrush}"
                                     BorderThickness="0,0,1,0"
                                     BorderBrush="{DynamicResource EditorPanelBorderBrush}"
                                     Foreground="{DynamicResource EditorTextBrush}"
                                     AllowDrop="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     KeyDown="ContentFolderListBox_KeyDown"
                                     MouseDoubleClick="ContentFolderListBox_MouseDoubleClick"
                                     PreviewMouseDown="ContentBrowserArea_PreviewMouseDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ContentFolderListItemBaseStyle}">
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ContentFolderItem_PreviewMouseLeftButtonDown" />
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="ContentFolder_PreviewMouseRightButtonDown" />
                                        <EventSetter Event="DragEnter" Handler="ContentFolder_DragEnter" />
                                        <EventSetter Event="Drop" Handler="ContentFolder_Drop" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="ContentFolderTreeRow" Margin="{Binding TreeIndent}" MinHeight="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="ContentFolderToggleButton"
                                                    Width="16"
                                                    Height="18"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="ContentFolderToggle_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Border Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasFolderChildren}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path x:Name="ContentFolderToggleIcon"
                                                      Width="8"
                                                      Height="8"
                                                      Stretch="Uniform"
                                                      Fill="{DynamicResource EditorMutedTextBrush}"
                                                      Style="{StaticResource ContentFolderToggleIconStyle}" />
                                            </Button>
                                            <Grid Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                         KeyDown="ContentAssetNameTextBox_KeyDown"
                                                         LostFocus="ContentAssetNameTextBox_LostFocus"
                                                         Style="{StaticResource ContentRenameTextBoxStyle}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource ContentAssetContextMenuStyle}">
                                        <MenuItem Style="{StaticResource ContentAssetMenuItemStyle}"
                                                  Header="重命名"
                                                  InputGestureText="F2"
                                                  Click="RenameContentAssetMenuItem_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource ContentAssetMenuIconStyle}"
                                                           Text="&#xE70F;"
                                                           Foreground="{DynamicResource EditorMutedTextBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Style="{StaticResource ContentAssetMenuItemStyle}"
                                                  Header="删除"
                                                  InputGestureText="Del"
                                                  Click="DeleteContentAssetMenuItem_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource ContentAssetMenuIconStyle}"
                                                           Text="&#xE74D;"
                                                           Foreground="{DynamicResource LogErrorBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <GridSplitter x:Name="ContentBrowserTreeSplitter"
                                          Grid.Column="1"
                                          Width="4"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="{DynamicResource EditorPanelBorderBrush}"
                                          ShowsPreview="True"
                                          ResizeBehavior="PreviousAndNext" />
                             <ListBox x:Name="ContentBrowserListBox"
                                  Grid.Column="2"
                                  ItemsSource="{Binding ContentVisibleItems}"
                                  Background="{DynamicResource EditorPanelCardBrush}"
                                  BorderThickness="0"
                                  Foreground="{DynamicResource EditorTextBrush}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="False"
                                  KeyDown="ContentBrowserListBox_KeyDown"
                                  MouseDoubleClick="ContentBrowserListBox_MouseDoubleClick"
                                  PreviewMouseDown="ContentBrowserArea_PreviewMouseDown"
                                  PreviewMouseRightButtonDown="ContentBrowserListBox_PreviewMouseRightButtonDown"
                                  PreviewMouseMove="ContentBrowserListBox_PreviewMouseMove">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"
                                               Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ContentAssetTileContainerStyle}">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ContentAsset_PreviewMouseRightButtonDown" />
                                    <EventSetter Event="DragEnter" Handler="ContentFolder_DragEnter" />
                                    <EventSetter Event="Drop" Handler="ContentFolder_Drop" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Width="54" Height="44" HorizontalAlignment="Center">
                                            <Border Width="44" Height="40" CornerRadius="6" Background="{Binding TileBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TileGlyph}" Foreground="{Binding TileGlyphForeground}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <CheckBox HorizontalAlignment="Right"
                                                      VerticalAlignment="Top"
                                                      IsChecked="{Binding IsScriptEnabled, Mode=OneWay}"
                                                      ToolTip="{Binding ScriptEnabledToolTip}"
                                                      Checked="ContentAssetScriptEnabledCheckBox_Changed"
                                                      Unchecked="ContentAssetScriptEnabledCheckBox_Changed"
                                                      Style="{StaticResource ScriptEnableBadgeStyle}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="ContentAssetNameTextBox_KeyDown"
                                                 LostFocus="ContentAssetNameTextBox_LostFocus"
                                                 Style="{StaticResource ContentRenameTextBoxStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu Style="{StaticResource ContentAssetContextMenuStyle}"
                                             Opened="ContentBrowserContextMenu_Opened"
                                             Closed="ContentBrowserContextMenu_Closed">
                                    <MenuItem x:Name="ContentBrowserRenameMenuItem"
                                              Style="{StaticResource ContentAssetMenuItemStyle}"
                                              Header="重命名"
                                              InputGestureText="F2"
                                              Click="RenameContentAssetMenuItem_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource ContentAssetMenuIconStyle}"
                                                       Text="&#xE70F;"
                                                       Foreground="{DynamicResource EditorMutedTextBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="ContentBrowserDeleteMenuItem"
                                              Style="{StaticResource ContentAssetMenuItemStyle}"
                                              Header="删除"
                                              InputGestureText="Del"
                                              Click="DeleteContentAssetMenuItem_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource ContentAssetMenuIconStyle}"
                                                       Text="&#xE74D;"
                                                       Foreground="{DynamicResource LogErrorBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="ContentBrowserPropertiesMenuItem"
                                              Style="{StaticResource ContentAssetMenuItemStyle}"
                                              Header="属性"
                                              InputGestureText="Alt+Enter"
                                              Click="ContentAssetPropertiesMenuItem_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource ContentAssetMenuIconStyle}"
                                               Text="&#xE713;"
                                               Foreground="{DynamicResource AccentBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="ContentBrowserToggleScriptEnabledMenuItem"
                                              Style="{StaticResource ContentAssetMenuItemStyle}"
                                              Header="启用脚本"
                                              IsCheckable="True"
                                              Click="ContentBrowserToggleScriptEnabledMenuItem_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource ContentAssetMenuIconStyle}"
                                                       Text="&#xE8FB;"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator x:Name="ContentBrowserAssetMenuSeparator" />
                                    <MenuItem x:Name="ContentBrowserNewScriptMenuItem"
                                              Style="{StaticResource ContentAssetMenuItemStyle}"
                                              Header="脚本"
                                              Click="NewScriptAsset_Click" />
                                    <MenuItem x:Name="ContentBrowserNewFolderMenuItem"
                                              Style="{StaticResource ContentAssetMenuItemStyle}"
                                              Header="文件夹"
                                              Click="NewContentFolder_Click" />
                                    <Separator x:Name="ContentBrowserNewLibraryMenuSeparator" />
                                    <MenuItem x:Name="ContentBrowserNewFunctionLibraryMenuItem"
                                              Style="{StaticResource ContentAssetMenuItemStyle}"
                                              Header="函数库"
                                              Click="NewFunctionLibraryAsset_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource EditorRootBackgroundBrush}"
                              ResizeDirection="Columns" />

                <Border Grid.Column="2"
                    Margin="3,6,6,6"
                    Background="{DynamicResource EditorPanelCardBrush}"
                    BorderBrush="{DynamicResource EditorPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Background="{DynamicResource EditorPanelElevatedBrush}"
                                Height="36">
                        <TextBlock Text="日志" Style="{StaticResource BottomPanelTitleStyle}" />
                        <TextBlock x:Name="StatusTextBlock" Foreground="{DynamicResource StatusMutedBrush}" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11" />
                        <Border Margin="12,0,0,0"
                                Background="{DynamicResource EditorFieldCardBrush}"
                                BorderBrush="{DynamicResource EditorPanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Height="22"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="FilterAllRadio" Content="全部" IsChecked="True" Checked="FilterRadio_Checked" Margin="4,0" Padding="6,0" FontSize="11" Foreground="{DynamicResource EditorTextBrush}" />
                                <RadioButton x:Name="FilterInfoRadio" Content="信息" Checked="FilterRadio_Checked" Margin="4,0" Padding="6,0" FontSize="11" Foreground="{DynamicResource EditorTextBrush}" />
                                <RadioButton x:Name="FilterWarnRadio" Content="警告" Checked="FilterRadio_Checked" Margin="4,0" Padding="6,0" FontSize="11" Foreground="{DynamicResource CompileDirtyBorderBrush}" />
                                <RadioButton x:Name="FilterErrorRadio" Content="错误" Checked="FilterRadio_Checked" Margin="4,0" Padding="6,0" FontSize="11" Foreground="{DynamicResource LogErrorBrush}" />
                            </StackPanel>
                        </Border>
                        <Button Content="清空" Click="ClearLog_Click" Margin="8,3,8,3" Padding="10,2" Height="24" FontSize="11" />
                    </StackPanel>

                    <RichTextBox x:Name="LogRichTextBox"
                                 Background="{DynamicResource EditorChromeBrush}"
                                 Foreground="{DynamicResource EditorTextBrush}"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 IsReadOnly="True"
                                 Padding="12,10"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
