<UserControl x:Class="AutomationStudioWpf.Controls.NumericUpDown" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinHeight="30">
  <StackPanel>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
    <TextBox x:Name="Input" Grid.Column="0" AutomationProperties.Name="数值输入" AutomationProperties.HelpText="输入数值，Enter 提交，Esc 取消" TextChanged="Input_TextChanged" PreviewKeyDown="Input_PreviewKeyDown" LostFocus="Input_LostFocus" Padding="6,3" Margin="0,0,22,0"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsValid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource ValidationErrorBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
    <TextBlock Grid.Column="0" Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0" Foreground="{DynamicResource ForegroundSecondaryBrush}" IsHitTestVisible="False" />
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <Button Content="▲" ToolTip="增加" AutomationProperties.Name="增加数值" Click="Up_Click" Padding="0"/><Button Grid.Row="1" Content="▼" ToolTip="减少" AutomationProperties.Name="减少数值" Click="Down_Click" Padding="0"/>
    </Grid>
  </Grid>
  <TextBlock Text="{Binding ErrorMessage, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource ValidationErrorBrush}" FontSize="11" TextWrapping="Wrap" Margin="4,2,0,0">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsValid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  </StackPanel>
</UserControl>
