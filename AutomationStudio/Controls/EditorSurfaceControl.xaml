                                    <ComboBoxItem Content="无限" Tag="Infinite" />
                                </ComboBox>
                                <TextBlock x:Name="WhileMaxIterationsLabel" Text="最大循环次数" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="WhileMaxIterationsTextBox" Margin="0,4,0,12" TextChanged="InspectorField_TextChanged" />
                            </StackPanel>

                            <StackPanel x:Name="StartProgramInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="程序路径" Foreground="{DynamicResource EditorTextBrush}" />
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="StartProgramPathTextBox" Grid.Column="0"
                                             Margin="0,0,4,0" TextChanged="InspectorField_TextChanged" />
                                    <Button Grid.Column="1" Content="..." Width="32" Height="24"
                                            Click="BrowseStartProgramPath_Click" />
                                </Grid>

                                <TextBlock Text="待响应时长 (ms)" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="StartProgramWaitTimeoutTextBox" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />

                                <TextBlock Text="失败后操作" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="StartProgramFailureActionComboBox" Margin="0,4,0,10" SelectionChanged="InspectorField_SelectionChanged">
                                    <ComboBoxItem Content="无" Tag="None" />
                                    <ComboBoxItem Content="尝试重启" Tag="Retry" />
                                </ComboBox>

                                <TextBlock x:Name="StartProgramRetryCountLabel" Text="重启次数" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="StartProgramRetryCountTextBox" Margin="0,4,0,12" TextChanged="InspectorField_TextChanged" />
                            </StackPanel>

                            <StackPanel x:Name="PrintLogInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="功能" Foreground="{DynamicResource EditorMutedTextBrush}" />
                                <TextBlock Margin="0,4,0,10" Foreground="{DynamicResource EditorMutedTextBrush}" Text="打印填入的字符串到 log 中。" TextWrapping="Wrap" />
                                <TextBlock x:Name="PrintLogMessageLabel" Text="字符串" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="PrintLogMessageTextBox" Margin="0,4,0,12" TextChanged="InspectorField_TextChanged" />
                            </StackPanel>

                            <StackPanel x:Name="SelectWindowInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="功能" Foreground="{DynamicResource EditorMutedTextBrush}" />
                                <TextBlock Margin="0,4,0,10"
                                           Foreground="{DynamicResource EditorMutedTextBrush}"
                                           Text="按进程名查找窗口，并把窗口恢复、置前、设为前台窗口。"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="输入模式" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="SelectWindowInputModeComboBox" Margin="0,4,0,10" SelectionChanged="SelectWindowInputMode_SelectionChanged">
                                    <ComboBoxItem Content="手动输入" Tag="Manual" />
                                    <ComboBoxItem Content="自动获取" Tag="Auto" />
                                </ComboBox>
                                <StackPanel x:Name="SelectWindowManualPanel">
                                    <TextBlock x:Name="SelectWindowProcessNameLabel" Text="进程名" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBox x:Name="SelectWindowProcessNameTextBox" Margin="0,4,0,12" TextChanged="InspectorField_TextChanged" />
                                </StackPanel>
                                <StackPanel x:Name="SelectWindowAutoPanel" Visibility="Collapsed">
                                    <TextBlock Text="选择窗口" Foreground="{DynamicResource EditorTextBrush}" />
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="SelectWindowAutoComboBox" Grid.Column="0" Margin="0,0,4,0" SelectionChanged="SelectWindowAutoComboBox_SelectionChanged" />
                                        <Button Grid.Column="1" Content="刷新" Width="48" Height="24" Padding="0" Click="RefreshWindowList_Click" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="ToDoInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="ToDo 目标" Foreground="{DynamicResource EditorMutedTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="搜索节点名或编号" Foreground="{DynamicResource EditorTextBrush}" Margin="0,10,0,0" />
                                <TextBox x:Name="ToDoSearchBox" Margin="0,4,0,8" TextChanged="ToDoSearchBox_TextChanged" />
                                <ListBox x:Name="ToDoTargetListBox"
                                         Style="{StaticResource DarkDropdownListBoxStyle}"
                                         MaxHeight="160"
                                         Margin="0,0,0,10"
                                         SelectionChanged="ToDoTargetListBox_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="4,3">
                                                <TextBlock Text="{Binding Number}"
                                                           DockPanel.Dock="Left"
                                                           Foreground="#FFD27A"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{DynamicResource EditorTextBrightBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="节点名" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="ToDoTargetTitleTextBox" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                <TextBlock Text="编号" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="ToDoTargetNumberTextBox" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                <CheckBox x:Name="ToDoReturnAfterTargetCheckBox"
                                          Content="目标执行完后返回 ToDo 输出"
                                          Foreground="{DynamicResource EditorTextBrush}"
                                          Margin="0,0,0,10"
                                          Checked="InspectorField_CheckedChanged"
                                          Unchecked="InspectorField_CheckedChanged" />
                                <TextBlock Text="运行时同时匹配节点名和编号；任一不匹配就停止。"
                                           Foreground="{DynamicResource StatusMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="KeyboardInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="按键" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="KeyboardKeyComboBox" Margin="0,4,0,12" SelectionChanged="InspectorField_SelectionChanged" />
                                <TextBlock Text="操作模式" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="KeyboardOperationModeComboBox" Margin="0,4,0,12" SelectionChanged="InspectorField_SelectionChanged">
                                    <ComboBoxItem Content="按下" Tag="Press" />
                                    <ComboBoxItem Content="抬起" Tag="Release" />
                                    <ComboBoxItem Content="点击" Tag="Click" />
                                </ComboBox>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="触发次数（0=无限）" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="触发间隔 (ms)" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBox x:Name="KeyboardTriggerCountTextBox" Grid.Row="1" Grid.Column="0" Margin="0,4,0,0" TextChanged="InspectorField_TextChanged" />
                                    <TextBox x:Name="KeyboardTriggerIntervalTextBox" Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" TextChanged="InspectorField_TextChanged" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="KeyChordInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="组合键" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="KeyChordTextBox" Margin="0,4,0,8" TextChanged="InspectorField_TextChanged" />
                                <DockPanel Margin="0,0,0,12">
                                    <Button Content="增加"
                                            DockPanel.Dock="Right"
                                            Padding="12,4"
                                            Margin="8,0,0,0"
                                            Click="KeyChordAddButton_Click" />
                                    <ComboBox x:Name="KeyChordKeyComboBox"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True" />
                                </DockPanel>
                                <TextBlock Text="操作模式" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="KeyChordOperationModeComboBox" Margin="0,4,0,12" SelectionChanged="InspectorField_SelectionChanged">
                                    <ComboBoxItem Content="按下" Tag="Press" />
                                    <ComboBoxItem Content="抬起" Tag="Release" />
                                    <ComboBoxItem Content="点击" Tag="Click" />
                                </ComboBox>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="触发次数（0=无限）" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="触发间隔 (ms)" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBox x:Name="KeyChordTriggerCountTextBox" Grid.Row="1" Grid.Column="0" Margin="0,4,0,0" TextChanged="InspectorField_TextChanged" />
                                    <TextBox x:Name="KeyChordTriggerIntervalTextBox" Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" TextChanged="InspectorField_TextChanged" />
                                </Grid>
                                <TextBlock Foreground="{DynamicResource EditorMutedTextBrush}"
                                           Text="点击模式会按下全部键、短暂停顿后反向释放；按下/抬起模式用于持续按键组合。"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="ScrollWheelInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="滚轮动作" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="ScrollWheelActionComboBox" Margin="0,4,0,12" SelectionChanged="InspectorField_SelectionChanged">
                                    <ComboBoxItem Content="中键按下" Tag="Press" />
                                    <ComboBoxItem Content="中键抬起" Tag="Release" />
                                    <ComboBoxItem Content="向前滚动" Tag="ScrollForward" />
                                    <ComboBoxItem Content="向后滚动" Tag="ScrollBackward" />
                                </ComboBox>
                                <TextBlock Text="滚动速度 (120=一个刻度)" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="ScrollWheelSpeedTextBox" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                <TextBlock Text="滚动间隔 (ms)" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="ScrollWheelIntervalTextBox" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                <TextBlock Text="滚动时长 (ms, 0=永久)" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="ScrollWheelDurationTextBox" Margin="0,4,0,12" TextChanged="InspectorField_TextChanged" />
                            </StackPanel>

                            <StackPanel x:Name="MouseMoveInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock x:Name="MouseMovePositionXLabel" Text="目标坐标 X" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="MouseMovePositionXTextBox" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                <TextBlock x:Name="MouseMovePositionYLabel" Text="目标坐标 Y" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="MouseMovePositionYTextBox" Margin="0,4,0,12" TextChanged="InspectorField_TextChanged" />
                            </StackPanel>

                            <StackPanel x:Name="CommonInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="通用参数" Foreground="{DynamicResource EditorMutedTextBrush}" FontWeight="SemiBold" />

                                <StackPanel x:Name="CommonKeyChordAddPanel" Visibility="Collapsed" Margin="0,10,0,10">
                                    <TextBlock Text="增加按键" Foreground="{DynamicResource EditorTextBrush}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <Button Content="增加"
                                                DockPanel.Dock="Right"
                                                Padding="12,4"
                                                Margin="8,0,0,0"
                                                Click="CommonKeyChordAddButton_Click" />
                                        <ComboBox x:Name="CommonKeyChordKeyComboBox"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel x:Name="CommonModePanel" Visibility="Collapsed" Margin="0,10,0,10">
                                    <TextBlock Text="目标选择模式" Foreground="{DynamicResource EditorTextBrush}" />
                                    <ComboBox x:Name="CommonModeComboBox" Margin="0,4,0,0" SelectionChanged="CommonModeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="手填进程名" Tag="Manual" />
                                        <ComboBoxItem Content="从运行窗口选择" Tag="Auto" />
                                        <ComboBoxItem Content="浏览 exe 自动填进程名" Tag="ExePath" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="CommonWindowPickerPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                    <TextBlock Text="选择运行窗口" Foreground="{DynamicResource EditorTextBrush}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <Button Content="刷新"
                                                DockPanel.Dock="Right"
                                                Width="48"
                                                Padding="0"
                                                Margin="8,0,0,0"
                                                Click="CommonWindowRefreshButton_Click" />
                                        <ComboBox x:Name="CommonWindowComboBox" SelectionChanged="CommonWindowComboBox_SelectionChanged" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel x:Name="CommonEnumPanel" Visibility="Collapsed" Margin="0,10,0,10">
                                    <TextBlock x:Name="CommonEnumLabel" Text="模式" Foreground="{DynamicResource EditorTextBrush}" />
                                    <ComboBox x:Name="CommonEnumComboBox"
                                              Margin="0,4,0,0"
                                              SelectionChanged="CommonEnumComboBox_SelectionChanged" />
                                </StackPanel>

                                <TextBlock x:Name="CommonTextLabel" Text="文本 1" Foreground="{DynamicResource EditorTextBrush}" Margin="0,10,0,0" />
                                <TextBox x:Name="CommonTextBox" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                <Button x:Name="CommonBrowseFileButton"
                                        Content="浏览"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,10"
                                        Padding="12,4"
                                        Click="CommonBrowseFileButton_Click" />

                                <TextBlock x:Name="CommonText2Label" Text="文本 2" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="CommonText2Box" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />

                                <TextBlock x:Name="CommonText3Label" Text="文本 3" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="CommonText3Box" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="CommonNumberLabel" Grid.Row="0" Grid.Column="0" Text="数值 1" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBlock x:Name="CommonNumber2Label" Grid.Row="0" Grid.Column="2" Text="数值 2" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBox x:Name="CommonNumberBox" Grid.Row="1" Grid.Column="0" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                    <TextBox x:Name="CommonNumber2Box" Grid.Row="1" Grid.Column="2" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                    <TextBlock x:Name="CommonNumber3Label" Grid.Row="2" Grid.Column="0" Text="数值 3" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBlock x:Name="CommonNumber4Label" Grid.Row="2" Grid.Column="2" Text="数值 4" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBox x:Name="CommonNumber3Box" Grid.Row="3" Grid.Column="0" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                    <TextBox x:Name="CommonNumber4Box" Grid.Row="3" Grid.Column="2" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                </Grid>

                                <CheckBox x:Name="CommonFlagCheckBox"
                                          Content="布尔值"
                                          Foreground="{DynamicResource EditorTextBrush}"
                                          Margin="0,0,0,10"
                                          Checked="InspectorField_CheckedChanged"
                                          Unchecked="InspectorField_CheckedChanged" />

                                <TextBlock x:Name="CommonHelpTextBlock"
                                           Foreground="{DynamicResource EditorMutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="ExecutionFrozenOverlay"
                        Grid.Column="0"
                        Grid.ColumnSpan="5"
                        Background="{DynamicResource EditorExecutionOverlayBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Panel.ZIndex="1000"
                        Cursor="Wait"
                        IsHitTestVisible="True">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExecutionFrozen, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Rectangle Height="3"
                                   VerticalAlignment="Top"
                                   Fill="{DynamicResource AccentBrush}"
                                   Opacity="0.75"
                                   RadiusX="2"
                                   RadiusY="2">
                            <Rectangle.RenderTransform>
                                <TranslateTransform Y="-20" />
                            </Rectangle.RenderTransform>
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="-20"
                                                             To="900"
                                                             Duration="0:0:1.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>

                        <Border Width="460"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="30"
                                Background="{DynamicResource EditorPanelElevatedBrush}"
                                BorderBrush="{DynamicResource EditorSelectedBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Style="{StaticResource EditorPanelDropShadowStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="74"
                                      Height="74"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,18">
                                    <Ellipse Stroke="{DynamicResource EditorPanelBorderBrush}"
                                             StrokeThickness="7"
                                             Opacity="0.75" />
                                    <Ellipse Stroke="{DynamicResource AccentBrush}"
                                             StrokeThickness="7"
                                             StrokeDashArray="2 3"
                                             StrokeStartLineCap="Round"
                                             StrokeEndLineCap="Round"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0"
                                                                         To="360"
                                                                         Duration="0:0:1.1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>

                                <TextBlock Text="正在执行脚本"
                                           Foreground="{DynamicResource EditorTextBrightBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Opacity" Value="0.86" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExecutionFrozen, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.58"
                                                                                 To="1"
                                                                                 Duration="0:0:0.7" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding ExecutionFreezeMessage, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                           FontSize="13"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />

                                <ProgressBar Height="8"
                                             Margin="0,22,0,0"
                                             Minimum="0"
                                             Maximum="100"
                                             IsIndeterminate="True" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
</UserControl>
