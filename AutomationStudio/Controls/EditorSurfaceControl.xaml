                                    <ComboBoxItem Content="False" />
                                    <ComboBoxItem Content="True" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="ForLoopInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="循环次数" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="ForLoopCountTextBox" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                <TextBlock x:Name="ForLoopEndConditionLabel" Text="结束条件（为真时跳出）" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="ForLoopEndConditionComboBox" Margin="0,4,0,12" SelectionChanged="InspectorField_SelectionChanged">
                                    <ComboBoxItem Content="False" />
                                    <ComboBoxItem Content="True" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="WhileLoopInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock x:Name="WhileConditionLabel" Text="结束条件（为真时跳出）" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="WhileLoopConditionComboBox" Margin="0,4,0,10" SelectionChanged="InspectorField_SelectionChanged">
                                    <ComboBoxItem Content="False" />
                                    <ComboBoxItem Content="True" />
                                </ComboBox>
                                <TextBlock Text="循环模式" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="WhileLoopModeComboBox" Margin="0,4,0,10" SelectionChanged="InspectorField_SelectionChanged">
