<UserControl x:Class="AutomationStudioWpf.Controls.EditorSurfaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:graph="clr-namespace:AutomationStudioWpf.Graph"
             xmlns:interaction="clr-namespace:AutomationStudioWpf.Interaction"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
    Background="{DynamicResource EditorRootBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AutomationStudioWpf;component/Themes/EditorSurfaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="EditorSectionCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource EditorPanelCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style x:Key="EditorSectionHeaderTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource EditorTextBrightBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorSidebarListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="6,3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid>
                            <Border x:Name="Shell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AccentBar"
                                            Grid.Column="0"
                                            Background="Transparent"
                                            CornerRadius="2"
                                            Margin="0,4,0,4" />
                                    <ContentPresenter Grid.Column="1"
                                                      Margin="10,4,10,4"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource EditorPanelCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource EditorListSelectedBrush}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource EditorSelectedBorderBrush}" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource EditorSelectedAccentBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCompileDirty}" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource CompileDirtyBorderBrush}" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource CompileDirtyBorderBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </UserControl.Resources>
            <Grid x:Name="EditorGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="GraphSidebarColumn" Width="248" MinWidth="180" MaxWidth="420" />
                    <ColumnDefinition x:Name="GraphSidebarSplitterColumn" Width="Auto" />
                    <ColumnDefinition x:Name="GraphCanvasColumn" Width="*" MinWidth="360" />
                    <ColumnDefinition x:Name="InspectorSplitterColumn" Width="Auto" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="472" MinWidth="420" MaxWidth="720" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="10,10,10,10"
                        Padding="0"
                        Background="{DynamicResource EditorPanelElevatedBrush}"
                        BorderBrush="{DynamicResource EditorPanelStrongBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10">
                        <Border x:Name="EventGraphPanel" Style="{StaticResource EditorSectionCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                        <Grid x:Name="EventGraphSection" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="EventGraphSectionToggle"
                                    Grid.Column="0"
                                    Content=">"
                                    Width="22"
                                    Height="24"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource EditorSidebarIconButtonStyle}"
                                    ToolTip="折叠/展开事件图表"
                                    Click="ToggleEventGraphSection_Click" />
                            <TextBlock Grid.Column="1"
                                       Text="事件图表"
                                       Style="{StaticResource EditorSectionHeaderTextStyle}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="EventGraphDirtyBadge"
                                        Width="10"
                                        Height="10"
                                        Margin="0,0,6,0"
                                        CornerRadius="5"
                                        Background="{DynamicResource CompileDirtyBorderBrush}"
                                        Visibility="Collapsed" />
                                <Button Content="+"
                                        Width="28"
                                        Height="26"
                                        Padding="0"
                                        Style="{StaticResource EditorSidebarIconButtonStyle}"
                                        ToolTip="新增图表"
                                        Click="AddGraphListItem_Click" />
                            </StackPanel>
                        </Grid>

                            <ListBox x:Name="GraphListBox"
                                 DockPanel.Dock="Top"
                                 ItemsSource="{Binding GraphListItems}"
                                 SelectedItem="{Binding SelectedGraphItem, Mode=TwoWay}"
                                 Margin="-4,2,-4,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource EditorTextBrush}"
                                 KeyDown="GraphListBox_KeyDown"
                                 MouseDoubleClick="GraphListBox_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource EditorSidebarListBoxItemStyle}">
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="GraphListItem_PreviewMouseLeftButtonDown" />
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="GraphListItem_PreviewMouseRightButtonDown" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource GraphItemDirtyGlyphStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Grid.Column="0"
                                                 Grid.ColumnSpan="2"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="GraphNameTextBox_KeyDown"
                                                 LostFocus="GraphNameTextBox_LostFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                    <MenuItem Header="重命名" Click="RenameGraphMenuItem_Click" />
                                    <MenuItem Header="删除" Click="DeleteGraphMenuItem_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                            </StackPanel>
                        </Border>
                        <Border x:Name="FunctionPanel" Style="{StaticResource EditorSectionCardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                        <Grid x:Name="FunctionSection" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FunctionSectionToggle"
                                    Grid.Column="0"
                                    Content=">"
                                    Width="22"
                                    Height="24"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource EditorSidebarIconButtonStyle}"
                                    ToolTip="折叠/展开函数"
                                    Click="ToggleFunctionSection_Click" />
                            <TextBlock Grid.Column="1" Text="函数" Style="{StaticResource EditorSectionHeaderTextStyle}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="FunctionDirtyBadge"
                                        Width="10"
                                        Height="10"
                                        Margin="0,0,6,0"
                                        CornerRadius="5"
                                        Background="{DynamicResource CompileDirtyBorderBrush}"
                                        Visibility="Collapsed" />
                                <Button Content="+"
                                        Width="28"
                                        Height="26"
                                        Padding="0"
                                        Style="{StaticResource EditorSidebarIconButtonStyle}"
                                        ToolTip="新增函数"
                                        Click="AddFunctionListItem_Click" />
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="FunctionListBox"
                                 DockPanel.Dock="Top"
                                 ItemsSource="{Binding FunctionListItems}"
                                 SelectedItem="{Binding SelectedFunctionItem, Mode=TwoWay}"
                                 Margin="-4,2,-4,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource EditorTextBrush}"
                                 KeyDown="FunctionListBox_KeyDown"
                                 MouseDoubleClick="FunctionListBox_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource EditorSidebarListBoxItemStyle}">
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FunctionListItem_PreviewMouseLeftButtonDown" />
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="FunctionListItem_PreviewMouseRightButtonDown" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource GraphItemDirtyGlyphStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding IsPublicToLibrary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="LibraryPublishCheckBox_Click">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource EditorFunctionPublishCheckBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowLibraryPublishOption}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <TextBox Grid.Column="0"
                                                 Grid.ColumnSpan="3"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                  KeyDown="GraphNameTextBox_KeyDown"
                                                  LostFocus="GraphNameTextBox_LostFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                    <MenuItem Header="重命名" Click="RenameGraphMenuItem_Click" />
                                    <MenuItem Header="删除" Click="DeleteGraphMenuItem_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <GridSplitter x:Name="GraphSidebarSplitter"
                              Grid.Column="1"
                              Width="7"
                              Style="{StaticResource EditorVerticalSplitterStyle}"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True" />

                <Border Grid.Column="2"
                        Margin="0,10,9,10"
                        Background="{DynamicResource EditorCanvasBackgroundBrush}"
                        BorderBrush="{DynamicResource EditorPanelStrongBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Border x:Name="GraphViewport"
                            ClipToBounds="True"
                            Focusable="True"
                            PreviewMouseWheel="GraphViewport_PreviewMouseWheel"
                            PreviewMouseLeftButtonDown="GraphViewport_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="GraphViewport_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="GraphViewport_PreviewMouseLeftButtonUp"
                            PreviewMouseRightButtonDown="GraphViewport_PreviewMouseRightButtonDown"
                            PreviewMouseRightButtonUp="GraphViewport_PreviewMouseRightButtonUp">
                        <Border.Background>
                            <DrawingBrush TileMode="Tile"
                                          Viewport="0,0,32,32"
                                          ViewportUnits="Absolute"
                                          Stretch="None">
                                <DrawingBrush.Transform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding ElementName=GraphZoomTransform, Path=ScaleX}"
                                                        ScaleY="{Binding ElementName=GraphZoomTransform, Path=ScaleY}"/>
                                        <TranslateTransform X="{Binding ElementName=GraphPanTransform, Path=X}"
                                                            Y="{Binding ElementName=GraphPanTransform, Path=Y}"/>
                                    </TransformGroup>
                                </DrawingBrush.Transform>
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="{DynamicResource EditorCanvasGridBackgroundBrush}">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,32,32" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="{x:Null}">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="{DynamicResource EditorCanvasGridLineBrush}" Thickness="1" />
                                            </GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <LineGeometry StartPoint="0,0" EndPoint="32,0" />
                                                    <LineGeometry StartPoint="0,0" EndPoint="0,32" />
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                        <Canvas>
                            <Canvas x:Name="GraphSurface"
                                    Canvas.Left="0" Canvas.Top="0"
                                    Width="400000"
                                    Height="400000">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="GraphZoomTransform" ScaleX="1" ScaleY="1" />
                                        <TranslateTransform x:Name="GraphPanTransform" X="0" Y="0" />
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <ItemsControl ItemsSource="{Binding ConnectionPaths}"
                                              Panel.ZIndex="100">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type graph:ConnectionPathViewModel}">
                                        <ContentControl MouseDoubleClick="ConnectionPath_MouseDoubleClick"
                                                        Background="Transparent"
                                                        BorderThickness="0">
                                            <ContentControl.ContextMenu>
                                                <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                                    <MenuItem Header="添加路由点" Click="AddRerouteToConnectionPath_Click" />
                                                    <MenuItem Header="删除连线" Click="DeleteConnectionPath_Click" />
                                                </ContextMenu>
                                            </ContentControl.ContextMenu>
                                            <Grid PreviewMouseRightButtonDown="ConnectionPath_PreviewMouseRightButtonDown">
                                                <Path Data="{Binding PathGeometry}"
                                                      Stroke="Transparent"
                                                      StrokeThickness="14"
                                                      SnapsToDevicePixels="True"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Cursor="Hand"
                                                      MouseLeftButtonDown="ConnectionPath_MouseLeftButtonDown"
                                                      PreviewMouseLeftButtonDown="ConnectionPath_PreviewMouseLeftButtonDown" />
                                            </Grid>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Path x:Name="PreviewConnectionPath"
                                  Visibility="Collapsed"
                                  Stroke="{DynamicResource EditorPreviewConnectionBrush}"
                                  StrokeThickness="4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeDashArray="4,4"
                                  IsHitTestVisible="False"
                                  Panel.ZIndex="450" />

                            <ItemsControl ItemsSource="{Binding Nodes}"
                                          Panel.ZIndex="200">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type graph:RerouteNodeViewModel}">
                                        <Border Width="20" Height="20"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Panel.ZIndex="100"
                                                PreviewMouseLeftButtonDown="NodeHeader_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="NodeHeader_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="NodeHeader_PreviewMouseLeftButtonUp">
                                            <Grid>
                                                <Ellipse x:Name="RerouteSelectionGlow"
                                                         Width="26"
                                                         Height="26"
                                                         Fill="Transparent"
                                                         Stroke="#FFD24A"
                                                         StrokeThickness="2.4"
                                                         Opacity="0"
                                                         IsHitTestVisible="False">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#FF9F1C"
                                                                          BlurRadius="12"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.95" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <Ellipse x:Name="RerouteSelectionRing"
                                                         Width="19"
                                                         Height="19"
                                                         Fill="Transparent"
                                                         Stroke="#0D0F12"
                                                         StrokeThickness="4"
                                                         Opacity="0"
                                                         IsHitTestVisible="False" />
                                                <Grid Width="6" Height="6"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Loaded="PinAnchor_Loaded"
                                                      LayoutUpdated="PinAnchor_LayoutUpdated"
                                                      DataContext="{Binding InputPins[0]}" />
                                                <Ellipse Width="14" Height="14"
                                                         Fill="{Binding CircleFill}"
                                                         Stroke="#0D0F12"
                                                         StrokeThickness="1.5" />
                                                <Grid Width="6" Height="6"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Loaded="PinAnchor_Loaded"
                                                      LayoutUpdated="PinAnchor_LayoutUpdated"
                                                      DataContext="{Binding OutputPins[0]}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="RerouteSelectionGlow" Property="Opacity" Value="1" />
                                                <Setter TargetName="RerouteSelectionRing" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type graph:NodeBaseViewModel}">
                                        <Border Width="{Binding Width}"
                                                Background="{DynamicResource EditorNodeBackgroundBrush}"
                                                BorderBrush="{Binding BorderBrush}"
                                                BorderThickness="2"
                                                CornerRadius="6"
                                                Opacity="0.96"
                                                SnapsToDevicePixels="True"
                                                Panel.ZIndex="100"
                                                PreviewMouseLeftButtonDown="NodeHeader_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="NodeHeader_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="NodeHeader_PreviewMouseLeftButtonUp"
                                                MouseLeftButtonDown="NodeCard_MouseLeftButtonDown">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        Background="{Binding HeaderBrush}"
                                                        CornerRadius="4,4,0,0"
                                                        Padding="10,4">
                                                    <DockPanel LastChildFill="True">
                                                        <Button DockPanel.Dock="Right"
                                                                Content="+"
                                                                Width="22"
                                                                Height="20"
                                                                Padding="0"
                                                                Margin="6,0,0,0"
                                                                FontWeight="Bold"
                                                                ToolTip="{Binding AddDynamicPinToolTip}"
                                                                Click="CommonVariadicAddButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanAddDynamicPin}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button DockPanel.Dock="Right"
                                                                Content="-"
                                                                Width="22"
                                                                Height="20"
                                                                Padding="0"
                                                                Margin="6,0,0,0"
                                                                FontWeight="Bold"
                                                                ToolTip="{Binding RemoveDynamicPinToolTip}"
                                                                Click="CommonVariadicRemoveButton_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanRemoveDynamicPin}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Border DockPanel.Dock="Left"
                                                                Background="#660D0F12"
                                                                CornerRadius="3"
                                                                Padding="5,1"
                                                                Margin="0,0,7,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasNodeNumber}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding NodeNumber}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding HeaderForegroundBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding HeaderForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Border>

                                                <Grid Grid.Row="1" Margin="4,6,4,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding InputPins}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Vertical" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type graph:PinViewModel}">
                                                                <Button PreviewMouseLeftButtonDown="PinButton_PreviewMouseLeftButtonDown"
                                                                        PreviewMouseLeftButtonUp="PinButton_PreviewMouseLeftButtonUp"
                                                                        Height="28"
                                                                        Padding="0"
                                                                        Margin="6,0,0,3"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        HorizontalAlignment="Left"
                                                                        Cursor="Hand">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Grid Width="12" Height="12"
                                                                              Loaded="PinAnchor_Loaded"
                                                                              LayoutUpdated="PinAnchor_LayoutUpdated">
                                                                            <Path x:Name="ExecTriangle"
                                                                                  Data="{Binding TriangleGeometry}"
                                                                                  Fill="{Binding PinFillBrush}"
                                                                                  Stroke="{Binding PinBrush}"
                                                                                  StrokeThickness="1.2"
                                                                                  Visibility="Collapsed" />
                                                                            <Ellipse x:Name="DataCircle"
                                                                                     Width="10"
                                                                                     Height="10"
                                                                                     Fill="{Binding PinFillBrush}"
                                                                                     Stroke="{Binding PinBrush}"
                                                                                     StrokeThickness="1.1"
                                                                                     Visibility="Visible" />
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   Margin="6,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource EditorTextBrightBrush}"
                                                                                   FontSize="12" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExecution}" Value="True">
                                                                        <Setter TargetName="ExecTriangle" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="DataCircle" Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Description}"
                                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                               FontSize="11"
                                                               Margin="8,0"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Left"
                                                               TextAlignment="Left"
                                                               TextWrapping="Wrap" />

                                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding OutputPins}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Vertical" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type graph:PinViewModel}">
                                                                <Button PreviewMouseLeftButtonDown="PinButton_PreviewMouseLeftButtonDown"
                                                                        PreviewMouseLeftButtonUp="PinButton_PreviewMouseLeftButtonUp"
                                                                        Height="28"
                                                                        Padding="0"
                                                                        Margin="0,0,6,3"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        HorizontalAlignment="Right"
                                                                        Cursor="Hand">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   Margin="0,0,6,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource EditorTextBrightBrush}"
                                                                                   FontSize="12" />
                                                                        <Grid Width="12" Height="12"
                                                                              Loaded="PinAnchor_Loaded"
                                                                              LayoutUpdated="PinAnchor_LayoutUpdated">
                                                                            <Path x:Name="ExecTriangle"
                                                                                  Data="{Binding TriangleGeometry}"
                                                                                  Fill="{Binding PinFillBrush}"
                                                                                  Stroke="{Binding PinBrush}"
                                                                                  StrokeThickness="1.2"
                                                                                  Visibility="Collapsed" />
                                                                            <Ellipse x:Name="DataCircle"
                                                                                     Width="10"
                                                                                     Height="10"
                                                                                     Fill="{Binding PinFillBrush}"
                                                                                     Stroke="{Binding PinBrush}"
                                                                                     StrokeThickness="1.1"
                                                                                     Visibility="Visible" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Button>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExecution}" Value="True">
                                                                        <Setter TargetName="ExecTriangle" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="DataCircle" Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding ConnectionPaths}"
                                          Panel.ZIndex="300"
                                          IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type graph:ConnectionPathViewModel}">
                                        <Grid>
                                            <Path Data="{Binding PathGeometry}"
                                                  Stroke="{DynamicResource EditorConnectionHitBrush}"
                                                  StrokeThickness="{Binding SelectionThickness}"
                                                  Opacity="{Binding SelectionOpacity}"
                                                  SnapsToDevicePixels="True"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                            <Path Data="{Binding PathGeometry}"
                                                  Stroke="{DynamicResource EditorConnectionOutlineBrush}"
                                                  StrokeThickness="{Binding OutlineThickness}"
                                                  SnapsToDevicePixels="True"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                            <Path Data="{Binding PathGeometry}"
                                                  Stroke="{Binding StrokeBrush}"
                                                  StrokeThickness="{Binding StrokeThickness}"
                                                  SnapsToDevicePixels="True"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Rectangle x:Name="SelectionRectangle"
                                       Visibility="Collapsed"
                                       Stroke="#66A8D5FF"
                                       StrokeThickness="1.5"
                                       Fill="#2258AFFF"
                                       RadiusX="2"
                                       RadiusY="2"
                                       Panel.ZIndex="500" />
                            </Canvas>

                            <Border x:Name="NodePalette"
                                    Visibility="Collapsed"
                                    Width="330"
                                    MaxHeight="540"
                                    Background="{DynamicResource EditorPanelElevatedBrush}"
                                    BorderBrush="{DynamicResource EditorSelectedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Style="{StaticResource EditorPanelDropShadowStyle}"
                                    Panel.ZIndex="1000">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource EditorChromeHighlightBrush}"
                                            CornerRadius="11,11,0,0"
                                            Padding="14,11,14,9">
                                        <StackPanel>
                                            <TextBlock Text="添加节点"
                                                       Foreground="{DynamicResource EditorTextBrightBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="15" />
                                            <TextBlock Text="搜索或选择要放到画布上的节点"
                                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBox x:Name="NodePaletteSearchBox"
                                             Grid.Row="1"
                                             Margin="12,10,12,0"
                                             Padding="10,7"
                                             MinHeight="34"
                                             Background="{DynamicResource EditorFieldCardBrush}"
                                             Foreground="{DynamicResource EditorTextBrush}"
                                             BorderBrush="{DynamicResource EditorSelectedBorderBrush}"
                                             BorderThickness="1"
                                             CaretBrush="{DynamicResource EditorTextBrush}"
                                             TextChanged="NodePaletteSearchBox_TextChanged"/>
                                     <ScrollViewer Grid.Row="2"
                                                   VerticalScrollBarVisibility="Auto"
                                                   HorizontalScrollBarVisibility="Disabled"
                                                   Margin="6,8,6,10"
                                                   PreviewMouseWheel="NodePaletteScrollViewer_PreviewMouseWheel">
                                        <StackPanel x:Name="NodePaletteContent">
                                            <!-- 动态生成节点列表 -->
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Canvas>
                    </Border>
                </Border>

                <GridSplitter x:Name="InspectorSplitter"
                              Grid.Column="3"
                              Width="7"
                              Style="{StaticResource EditorVerticalSplitterStyle}"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True" />

                <Border x:Name="InspectorPanel"
                        Grid.Column="4"
                        Margin="0,10,9,10"
                        Padding="15"
                        Background="{DynamicResource EditorPanelElevatedBrush}"
                        BorderBrush="{DynamicResource EditorPanelStrongBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Border.Resources>
                        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource EditorInspectorTextBoxStyle}" />
                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource EditorInspectorComboBoxStyle}" />
                        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource EditorInspectorCheckBoxStyle}" />
                    </Border.Resources>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource EditorSectionCardStyle}" Margin="0,0,0,12" Padding="12">
                                <StackPanel>
                            <DockPanel Margin="0,0,0,2">
                                <Border DockPanel.Dock="Left"
                                        Width="4"
                                        Height="22"
                                        Margin="0,0,9,0"
                                        CornerRadius="2"
                                        Background="{DynamicResource EditorSelectedAccentBrush}" />
                                <TextBlock x:Name="DetailsPanelTitleTextBlock"
                                           Text="细节面板"
                                           Style="{StaticResource EditorSectionHeaderTextStyle}"
                                           FontSize="18" />
                            </DockPanel>
                            <TextBlock x:Name="InspectorHintTextBlock"
                                       Margin="0,8,0,14"
                                       Text="请选择一个节点进行编辑。"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <ContentControl x:Name="ScriptPropertiesSummaryHost"
                                            Visibility="Collapsed"
                                            Margin="0,0,0,4"
                                            HorizontalContentAlignment="Stretch" />
                            <Border Margin="0,4,0,0"
                                    Padding="10,8,10,2"
                                    Background="{DynamicResource EditorFieldCardBrush}"
                                    BorderBrush="{DynamicResource EditorPanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                            <StackPanel x:Name="NodeBasicsPanel">
                                <TextBlock Text="节点名称" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="NodeTitleTextBox" Margin="0,4,0,12" TextChanged="InspectorField_TextChanged" />
                                <TextBlock Text="节点编号" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBlock x:Name="NodeNumberTextBlock"
                                           Text="N001"
                                           Style="{StaticResource EditorReadonlyChipStyle}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            </Border>
                                </StackPanel>
                            </Border>

                            <ContentControl x:Name="StructuredInspectorHost"
                                            Visibility="Collapsed"
                                            Margin="0,0,0,12">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Sections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource EditorSectionCardStyle}"
                                                            Margin="0,0,0,10"
                                                            Padding="10">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       Style="{StaticResource EditorSectionHeaderTextStyle}"
                                                                       Margin="0,0,0,8" />
                                                            <ItemsControl ItemsSource="{Binding Fields}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,0,0,9">
                                                                            <TextBlock Text="{Binding Label}"
                                                                                       Foreground="{DynamicResource EditorTextBrush}" />
                                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                     IsEnabled="{Binding IsEnabled}"
                                                                                     AcceptsReturn="{Binding IsMultiline}"
                                                                                     TextWrapping="Wrap"
                                                                                     VerticalScrollBarVisibility="Auto"
                                                                                     Margin="0,4,0,0">
                                                                                <TextBox.Style>
                                                                                    <Style TargetType="TextBox"
                                                                                           BasedOn="{StaticResource EditorInspectorTextBoxStyle}">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsEnum}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBox.Style>
                                                                            </TextBox>
                                                                            <ComboBox ItemsSource="{Binding Options}"
                                                                                      DisplayMemberPath="Label"
                                                                                      SelectedValue="{Binding SelectedOption, UpdateSourceTrigger=PropertyChanged}"
                                                                                      SelectedValuePath="Value"
                                                                                      IsEnabled="{Binding IsEnabled}"
                                                                                      Margin="0,4,0,0">
                                                                                <ComboBox.Style>
                                                                                    <Style TargetType="ComboBox">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsEnum}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </ComboBox.Style>
                                                                            </ComboBox>
                                                                            <CheckBox IsChecked="{Binding BooleanValue, UpdateSourceTrigger=PropertyChanged}"
                                                                                      IsEnabled="{Binding IsEnabled}"
                                                                                      Content="使用默认值"
                                                                                      Foreground="{DynamicResource EditorTextBrush}"
                                                                                      Margin="0,4,0,0">
                                                                                <CheckBox.Style>
                                                                                    <Style TargetType="CheckBox"
                                                                                           BasedOn="{StaticResource EditorInspectorCheckBoxStyle}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </CheckBox.Style>
                                                                            </CheckBox>
                                                                            <TextBlock Text="{Binding HelpText}"
                                                                                       Foreground="{DynamicResource EditorMutedTextBrush}"
                                                                                       TextWrapping="Wrap"
                                                                                       Margin="0,3,0,0" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                                <ContentControl.Content>
                                    <Binding Path="StructuredInspector" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                </ContentControl.Content>
                            </ContentControl>

                            <StackPanel x:Name="ParameterInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="AddParameterButton"
                                            Content="+"
                                            DockPanel.Dock="Right"
                                            Width="28"
                                            Height="24"
                                            Padding="0"
                                            Click="AddParameterButton_Click" />
                                    <TextBlock x:Name="ParameterInspectorTitle"
                                               Text="参数"
                                               Foreground="{DynamicResource EditorTextBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel x:Name="ParameterRowsPanel" />
                            </StackPanel>

                            <StackPanel x:Name="FindImageInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="查找源" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="FindImageSourceModeComboBox"
                                          Margin="0,4,0,10"
                                          SelectionChanged="FindImageSourceModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="手动配置（输入图像路径）" Tag="ManualImage" />
                                    <ComboBoxItem Content="实时截屏" Tag="RealtimeScreenshot" />
                                </ComboBox>
                                <TextBlock x:Name="FindImageSourcePathLabel" Text="查找源图像路径" Foreground="{DynamicResource EditorTextBrush}" />
                                <DockPanel x:Name="FindImageSourcePathPanel" Margin="0,4,0,10">
                                    <Button Content="浏览" DockPanel.Dock="Right" Padding="12,4" Click="BrowseFindImageSourcePath_Click" />
                                    <TextBox x:Name="FindImageSourcePathTextBox" Margin="0,0,8,0" TextChanged="InspectorField_TextChanged" />
                                </DockPanel>
                                <TextBlock Text="查找目标" Foreground="{DynamicResource EditorTextBrush}" />
                                <DockPanel Margin="0,4,0,10">
                                    <Button Content="浏览" DockPanel.Dock="Right" Padding="12,4" Click="BrowseFindImagePath_Click" />
                                    <TextBox x:Name="FindImagePathTextBox" Margin="0,0,8,0" TextChanged="InspectorField_TextChanged" />
                                </DockPanel>
                                <TextBlock Text="相似度阈值 (%)" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="FindImageThresholdTextBox" Margin="0,4,0,12" TextChanged="InspectorField_TextChanged" />
                                <CheckBox x:Name="FindImageUseRegionCheckBox"
                                          Content="限制识别区域"
                                          Margin="0,0,0,10"
                                          Foreground="{DynamicResource EditorTextBrush}"
                                          Checked="InspectorField_CheckedChanged"
                                          Unchecked="InspectorField_CheckedChanged" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="区域 X" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="区域 Y" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBox x:Name="FindImageRegionXTextBox" Grid.Row="1" Grid.Column="0" Margin="0,4,0,8" TextChanged="InspectorField_TextChanged" />
                                    <TextBox x:Name="FindImageRegionYTextBox" Grid.Row="1" Grid.Column="2" Margin="0,4,0,8" TextChanged="InspectorField_TextChanged" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="区域宽" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="区域高" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBox x:Name="FindImageRegionWidthTextBox" Grid.Row="3" Grid.Column="0" Margin="0,4,0,0" TextChanged="InspectorField_TextChanged" />
                                    <TextBox x:Name="FindImageRegionHeightTextBox" Grid.Row="3" Grid.Column="2" Margin="0,4,0,0" TextChanged="InspectorField_TextChanged" />
                                </Grid>
                                <TextBlock Text="说明" Foreground="{DynamicResource EditorMutedTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource EditorMutedTextBrush}"
                                           Text="达到阈值即认为找到了图像。可限制屏幕识别区域；未启用时默认全屏。节点输出会提供成功 bool 和中心点 Vector2D。"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="MouseLeftInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="鼠标按键" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="MouseButtonComboBox" Margin="0,4,0,12" SelectionChanged="InspectorField_SelectionChanged">
                                    <ComboBoxItem Content="左键" Tag="Left" />
                                    <ComboBoxItem Content="右键" Tag="Right" />
                                    <ComboBoxItem Content="中键" Tag="Middle" />
                                    <ComboBoxItem Content="侧键1" Tag="XButton1" />
                                    <ComboBoxItem Content="侧键2" Tag="XButton2" />
                                </ComboBox>

                                <TextBlock Text="操作模式" Foreground="{DynamicResource EditorTextBrush}" />
                                <ComboBox x:Name="MouseClickOperationModeComboBox" Margin="0,4,0,12" SelectionChanged="InspectorField_SelectionChanged">
                                    <ComboBoxItem Content="按下" Tag="Press" />
                                    <ComboBoxItem Content="抬起" Tag="Release" />
                                    <ComboBoxItem Content="点击" Tag="Click" />
                                </ComboBox>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="触发次数（0=无限）" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="触发间隔 (ms)" Foreground="{DynamicResource EditorTextBrush}" />
                                    <TextBox x:Name="MouseTriggerCountTextBox" Grid.Row="1" Grid.Column="0" Margin="0,4,0,0" TextChanged="InspectorField_TextChanged" />
                                    <TextBox x:Name="MouseTriggerIntervalTextBox" Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" TextChanged="InspectorField_TextChanged" />
                                </Grid>

                                <TextBlock x:Name="MousePositionXLabel" Text="点击位置 X" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="MousePositionXTextBox" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />
                                <TextBlock x:Name="MousePositionYLabel" Text="点击位置 Y" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="MousePositionYTextBox" Margin="0,4,0,10" TextChanged="InspectorField_TextChanged" />

                                <TextBlock Text="说明" Foreground="{DynamicResource EditorMutedTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource EditorMutedTextBrush}"
                                           Text="位置可手动填写，也可由前序节点的 Vector2D 输出引脚连接提供。双击可用：触发次数 2 + 间隔 80~150ms。"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="DelayInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="延迟时长 (ms)" Foreground="{DynamicResource EditorTextBrush}" />
                                <TextBox x:Name="DelayMsTextBox" Margin="0,4,0,12" TextChanged="InspectorField_TextChanged" />
                            </StackPanel>

                            <StackPanel x:Name="IfInspectorPanel" Visibility="Collapsed" Margin="0,0,0,12">
